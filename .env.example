ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional
# PORT=3000
# API_PORT=3000             # port the Vite dev proxy forwards /api to
# APP_PASSWORD=            # passphrase the web app asks for before using the API; required in production
# RUNNER_IMAGE_CLAUDE=agent-runner-claude:latest
# RUNNER_IMAGE_CODEX=agent-runner-codex:latest
# SANDBOX_PROVIDER=docker   # docker (local) | railway (Railway sandboxes)
# With SANDBOX_PROVIDER=railway:
# RAILWAY_TOKEN=            # project token for the environment the sandboxes run in
# Or, instead of RAILWAY_TOKEN:
# RAILWAY_API_TOKEN=        # account or workspace token
# RAILWAY_ENVIRONMENT_ID=   # required with RAILWAY_API_TOKEN
# RAILWAY_SANDBOX_IDLE_TIMEOUT_MINUTES=5
